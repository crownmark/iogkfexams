@page "/exam-sections"
@attribute [Authorize]

<PageTitle>ExamSections</PageTitle>
<RadzenStack>
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenText Text="ExamSections" TextStyle="TextStyle.H3" TagName="TagName.H1" style="margin: 0" />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenSplitButton Icon="get_app" Text="Export" Click="@ExportClick" Variant="Variant.Flat" Shade="Shade.Lighter">
                    <RadzenSplitButtonItem Text="Excel" Value="xlsx" />
                    <RadzenSplitButtonItem Text="CSV" Value="csv" />
                </RadzenSplitButton>
                <RadzenButton Icon="add_circle_outline" Text="Add" Click="@AddButtonClick" Variant="Variant.Flat" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
    <RadzenTextBox Placeholder="Search ..." style="display: block; width: 100%" @oninput="@Search" aria-label="Search by all string columns" />
    <RadzenRow>
      <RadzenColumn SizeMD=12>
        <RadzenDataGrid @ref="grid0" ColumnWidth="200px"   AllowFiltering="true"  AllowPaging="true" PagerAlwaysVisible="true"  AllowSorting="true" ShowPagingSummary="true" PageSizeOptions=@([5, 10, 20, 30,50,100]) AllowColumnResize="true"
            Data="@(examSections)" LoadData="@Grid0LoadData" Count="@count" TItem="IOGKFExams.Server.Models.IOGKFExamsDb.ExamSection" RowSelect="@EditRow">
            <Columns>
                <RadzenDataGridColumn TItem="IOGKFExams.Server.Models.IOGKFExamsDb.ExamSection" Property="ExamSectionId" Title="Exam Section Id">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="IOGKFExams.Server.Models.IOGKFExamsDb.ExamSection" Property="ExamSectionName" Title="Exam Section Name">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="IOGKFExams.Server.Models.IOGKFExamsDb.ExamSection" Property="Active" Title="Active">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="IOGKFExams.Server.Models.IOGKFExamsDb.ExamSection" Property="LanguageId" Title="Language Id">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="IOGKFExams.Server.Models.IOGKFExamsDb.ExamSection" Filterable="false" Sortable="false" Width="70px" TextAlign="TextAlign.Center">
                    <Template Context="examSection">

                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Size="ButtonSize.Medium"
                            Shade="Shade.Lighter" Variant="Variant.Flat"
                            Click=@(args => GridDeleteButtonClick(args, examSection)) @onclick:stopPropagation="true" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>

        </RadzenDataGrid>

    </RadzenColumn>
  </RadzenRow>
</RadzenStack>
