<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
<!-- Prevent inherited WebDAV from intercepting DELETE/PUT -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
<remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />

      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\IOGKFExams.Server.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
